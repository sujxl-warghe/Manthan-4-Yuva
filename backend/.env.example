# ── Local development (default, no setup needed) ────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./vrukshasetu.db

# ── Production (Render / Railway / Neon Postgres) ───────────────────────────
# Paste the connection string your provider gives you as-is — postgres://,
# postgresql://, or postgresql+asyncpg:// are all accepted automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app

ENVIRONMENT=production